# Host port used to open SynthIPTV and by the protected runtime.
SYNTHIPTV_PORT=8892

# Persistent SynthIPTV configuration directory.
SYNTHIPTV_CONFIG=./config

# Release image. Normally leave this unchanged.
SYNTHIPTV_IMAGE=ghcr.io/dmesgnoise/synthiptv:1.0

# Optional. Required only for supported protected sources.
# Obtain the official Synth Protected Runtime release URL and place it here.
SYNTH_PROTECTED_RUNTIME_URL=
